# Banco de Dados (PostgreSQL)
POSTGRES_DB=speech_pipeline
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Modelo de Transcricao (faster-whisper)
# device pode ser 'cuda' (RTX 4050) ou 'cpu' como fallback
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# LLM Local (Ollama - Etapa 2)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LIVE_OLLAMA_MODEL=qwen2.5:3b
